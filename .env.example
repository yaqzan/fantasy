# Copy to .env (gitignored).

# Your Fantrax login and league (the league id is in your league's URL).
FANTRAX_USERNAME=
FANTRAX_PASSWORD=
FANTRAX_LEAGUE_ID=

# Extra browser origins allowed to call the API, comma-separated.
FANTASY_CORS_ORIGINS=http://localhost:3001

# MySQL (defaults: database "fantasy", user "root", no password, local server).
# FANTASY_DB_NAME=fantasy
# FANTASY_DB_USER=root
# FANTASY_DB_PASSWORD=
# FANTASY_DB_HOST=127.0.0.1
